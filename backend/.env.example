# ---- Database ----
DB_URL=sqlite:///./app.db

# ---- Goal ACoS (headline knob; also overridable per-request from the UI) ----
TARGET_ACOS=0.25
MIN_SPEND=5.0
MIN_CLICKS=5

# ---- LLM (ALL OPTIONAL — app runs fully with provider=none) ----
# provider: none | ollama | lmstudio | openclaw | openai_compat
LLM_PROVIDER=none
LLM_MODEL=llama3.1
# leave blank to use each provider's default localhost URL:
#   ollama   -> http://localhost:11434
#   lmstudio -> http://localhost:1234/v1
#   openai_compat -> http://localhost:8000/v1
#   openclaw -> path to the openclaw binary (default: "openclaw")
LLM_BASE_URL=
# set true to route the provider through LangChain (requires langchain-core)
LLM_USE_LANGCHAIN=false
LLM_TIMEOUT=120
