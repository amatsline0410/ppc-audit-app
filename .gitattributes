# Force LF line endings on all text so Windows checkouts don't rewrite
# bash scripts (run.sh) to CRLF — a CRLF shebang line fails on Linux.
* text=auto eol=lf

# Binary assets: never touch.
*.xlsx binary
*.xlsm binary
*.xls  binary
*.db   binary
*.png  binary
*.jpg  binary
*.ico  binary

# Batch files legitimately want CRLF on Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf
